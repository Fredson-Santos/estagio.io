---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Vagas de Gupy, CIEE, Vagas.com, InfoJobs e Catho reunidas num lugar só — com busca, filtros e sem o ruído de vaga já encerrada." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="GSC_MOCK_VERIFICATION_CODE_12345" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
