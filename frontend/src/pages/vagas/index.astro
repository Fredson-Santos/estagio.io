---
import Layout from '../../layouts/Layout.astro';
import JobCard from '../../components/JobCard.astro';
import { formatModality } from '../../utils/modality';
import { fetchJobs } from '../../lib/api';
import type { Job, JobWithDisplay } from '../../lib/types';

export const prerender = false;

// Pegar os parâmetros de busca da URL para repassar ao backend
const url = new URL(Astro.request.url);
const searchParams = url.searchParams;

// Paginação
const LIMIT = 21; // 3 colunas x 7 linhas
const currentPage = Math.max(1, parseInt(searchParams.get('page') || '1', 10));
const skip = (currentPage - 1) * LIMIT;
const sortParam = searchParams.get('sort') || 'recent';

// Mapear parâmetros do frontend para o backend
const query = new URLSearchParams();
if (searchParams.get('q'))        query.append('q',        searchParams.get('q') || '');
if (searchParams.get('location')) query.append('location', searchParams.get('location') || '');
if (searchParams.get('type'))     query.append('type',     searchParams.get('type') || '');
if (searchParams.get('modality')) query.append('modality', searchParams.get('modality') || '');
if (searchParams.get('company'))  query.append('company',  searchParams.get('company') || '');

// Fetch jobs do backend
let jobs: JobWithDisplay[] = [];
let total = 0;
let hasBackendError = false;

try {
  const data = await fetchJobs(`/jobs?${query.toString()}&limit=${LIMIT}&skip=${skip}`);
  jobs = data.items.map((job: Job) => ({
    ...job,
    publishedAt: job.posted_at ? new Date(job.posted_at).toLocaleDateString('pt-BR') : 'Recente',
    logo: job.company_logo || undefined,
    modality: formatModality(job.modality),
    sourceUrl: job.source_url,
    sourceName: job.source_name || undefined,
  }));
  total = data.total;
} catch (e) {
  console.error('Erro ao buscar vagas do backend', e);
  hasBackendError = true;
}

// Ordenação cliente/fallback se solicitada
if (sortParam === 'company') {
  jobs.sort((a, b) => (a.company || '').localeCompare(b.company || ''));
} else if (sortParam === 'title') {
  jobs.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
}

// Cálculo de páginas
const totalPages = Math.max(1, Math.ceil(total / LIMIT));

let pagesToShow: number[] = [];
if (totalPages <= 3) {
  for (let i = 1; i <= totalPages; i++) pagesToShow.push(i);
} else if (currentPage === 1) {
  pagesToShow = [1, 2, totalPages];
} else if (currentPage === totalPages) {
  pagesToShow = [1, totalPages - 1, totalPages];
} else {
  pagesToShow = [1, currentPage, totalPages];
}

const btnBase = "w-10 h-10 flex items-center justify-center rounded-xl font-label-md text-label-md transition-all active:scale-95 select-none";
const btnInactive = `${btnBase} bg-surface-container-low text-on-surface-variant hover:bg-surface-container border border-transparent`;
const btnActive  = `${btnBase} bg-on-surface text-surface shadow-sm pointer-events-none`;
const btnArrow   = `${btnBase} bg-surface-container-low text-on-surface-variant hover:bg-surface-container border border-transparent`;
const btnArrowDisabled = `${btnBase} bg-surface-container-low/50 text-outline/30 cursor-not-allowed`;

// Função para gerar URL de uma página preservando todos os filtros ativos
function pageUrl(page: number): string {
  const params = new URLSearchParams(searchParams.toString());
  if (page === 1) {
    params.delete('page');
  } else {
    params.set('page', String(page));
  }
  const qs = params.toString();
  return `/vagas${qs ? `?${qs}` : ''}`;
}
---

<Layout 
  title="Vagas | estagio.io"
  description="Encontre sua próxima vaga de estágio. Filtre por área, regime e mais."
>
  <div class="pt-24 pb-xl px-gutter max-w-container-max mx-auto w-full">
    <!-- Search Section -->
    <section class="mb-lg">
      <form action="/vagas" method="GET" class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant filter-shadow" id="filter-form">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-md items-center mb-md">
          <div class="md:col-span-6 relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">search</span>
            <input name="q" value={searchParams.get('q') || ''} class="w-full pl-12 pr-4 py-3 bg-surface border-outline-variant border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface-variant" placeholder="Pesquise por títulos, palavras-chave ou empresas..." type="text"/>
          </div>
          <div class="md:col-span-3 relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">location_on</span>
            <input name="location" value={searchParams.get('location') || ''} class="w-full pl-12 pr-4 py-3 bg-surface border-outline-variant border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface-variant" placeholder="Cidade ou remoto" type="text"/>
          </div>
          <div class="md:col-span-3">
            <button type="submit" class="w-full bg-primary text-on-primary px-xl py-3 rounded-lg font-label-md text-label-md hover:bg-primary-container transition-all flex items-center justify-center gap-sm whitespace-nowrap">
              <span>Buscar Vagas</span>
            </button>
          </div>
        </div>

        <!-- Filtros dentro do form para serem enviados na busca -->
        <div class="flex flex-wrap items-center gap-md pt-md border-t border-outline-variant/30">
          <div class="relative group">
            <select id="select-type" name="type" aria-label="Tipo de Estágio" class="appearance-none bg-none bg-surface-container-low border border-outline-variant rounded-full pl-md pr-10 py-2 font-label-md text-label-md text-on-surface-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none cursor-pointer transition-all">
              <option value="" selected={!searchParams.get('type')}>Tipo de Estágio</option>
              <option value="PART_TIME" selected={searchParams.get('type') === 'PART_TIME'}>Meio Período</option>
              <option value="FULL_TIME" selected={searchParams.get('type') === 'FULL_TIME'}>Período Integral</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[20px]">expand_more</span>
          </div>
          <div class="relative group">
            <select id="select-modality" name="modality" aria-label="Modalidade" class="appearance-none bg-none bg-surface-container-low border border-outline-variant rounded-full pl-md pr-10 py-2 font-label-md text-label-md text-on-surface-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none cursor-pointer transition-all">
              <option value="" selected={!searchParams.get('modality')}>Modalidade</option>
              <option value="REMOTE"  selected={searchParams.get('modality') === 'REMOTE'}>Remoto</option>
              <option value="HYBRID"  selected={searchParams.get('modality') === 'HYBRID'}>Híbrido</option>
              <option value="ONSITE"  selected={searchParams.get('modality') === 'ONSITE'}>Presencial</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[20px]">expand_more</span>
          </div>
          <a href="/vagas" id="clear-filters-btn" class="text-primary font-label-md hover:underline px-sm py-2">Limpar filtros</a>
        </div>
      </form>
    </section>

    <div class="flex flex-col gap-xl">
      <!-- Main Job Feed -->
      <div class="flex-grow">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-lg gap-md">
          <p class="font-body-sm text-body-sm text-on-surface-variant">Mostrando <span class="font-bold text-on-surface">{total}</span> oportunidades de estágio</p>
          <div class="flex items-center gap-sm">
            <span class="text-label-sm font-label-sm text-outline">Ordenar por:</span>
            <div class="relative">
              <select id="select-sort" aria-label="Ordenar vagas por" class="appearance-none bg-none bg-transparent border-none focus:ring-0 font-label-md text-label-md text-primary cursor-pointer pr-8 py-0 outline-none">
                <option value="recent" selected={sortParam === 'recent'}>Mais recentes</option>
                <option value="company" selected={sortParam === 'company'}>Empresa (A-Z)</option>
                <option value="title" selected={sortParam === 'title'}>Título (A-Z)</option>
              </select>
              <span class="material-symbols-outlined absolute right-0 top-1/2 -translate-y-1/2 text-primary pointer-events-none text-[18px]">expand_more</span>
            </div>
          </div>
        </div>

        {hasBackendError ? (
          <div class="bg-error-container/20 border border-error/30 rounded-2xl p-8 sm:p-12 text-center my-lg max-w-[640px] mx-auto shadow-sm">
            <div class="w-16 h-16 rounded-full bg-error-container/40 border border-error/30 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-3xl text-error">error_outline</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-2 font-bold">Não foi possível carregar as vagas</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-6 max-w-[460px] mx-auto leading-relaxed">
              Ocorreu um erro de conexão com o servidor. Por favor, tente novamente.
            </p>
            <a href="/vagas" class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-xl font-label-md hover:bg-primary-container active:scale-95 transition-all shadow-sm">
              <span class="material-symbols-outlined text-[20px]">refresh</span>
              Tentar novamente
            </a>
          </div>
        ) : jobs.length === 0 ? (
          <div class="bg-surface-container-low border border-outline-variant/50 rounded-2xl p-8 sm:p-12 text-center my-lg max-w-[640px] mx-auto shadow-sm">
            <div class="w-16 h-16 rounded-full bg-surface-container-high border border-outline-variant/40 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-3xl text-outline">search_off</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-2 font-bold">Nenhuma vaga encontrada</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-6 max-w-[460px] mx-auto leading-relaxed">
              Não encontramos oportunidades que correspondam aos filtros selecionados. Tente ajustar os termos ou limpar os filtros.
            </p>
            <a id="clear-filters-card-btn" href="/vagas" class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-xl font-label-md hover:bg-primary-container active:scale-95 transition-all shadow-sm">
              <span class="material-symbols-outlined text-[20px]">filter_alt_off</span>
              Limpar todos os filtros
            </a>
          </div>
        ) : (
          <div id="job-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
            {jobs.map((job: JobWithDisplay) => (
              <JobCard {...job} searchParams={searchParams.toString()} />
            ))}
          </div>
        )}

        <!-- Paginação -->
        {totalPages > 1 && (
          <nav class="mt-xl flex items-center justify-center gap-sm" aria-label="Paginação">
            {/* Seta esquerda */}
            {currentPage > 1 ? (
              <a href={pageUrl(currentPage - 1)} class={`pagination-link ${btnArrow}`} aria-label="Página anterior">
                <span class="material-symbols-outlined text-[20px]">chevron_left</span>
              </a>
            ) : (
              <span class={btnArrowDisabled}>
                <span class="material-symbols-outlined text-[20px]">chevron_left</span>
              </span>
            )}

            {/* Botões numerados */}
            {pagesToShow.map((p) =>
              p === currentPage ? (
                <span class={btnActive}>{p}</span>
              ) : (
                <a href={pageUrl(p)} class={`pagination-link ${btnInactive}`}>{p}</a>
              )
            )}

            {/* Seta direita */}
            {currentPage < totalPages ? (
              <a href={pageUrl(currentPage + 1)} class={`pagination-link ${btnArrow}`} aria-label="Próxima página">
                <span class="material-symbols-outlined text-[20px]">chevron_right</span>
              </a>
            ) : (
              <span class={btnArrowDisabled}>
                <span class="material-symbols-outlined text-[20px]">chevron_right</span>
              </span>
            )}
          </nav>
        )}

      </div>
    </div>
  </div>
</Layout>

<style>
  /* Animação de entrada dos cards */
  #job-grid > * {
    animation: cardIn 0.35s ease both;
  }
  #job-grid > *:nth-child(1)  { animation-delay: 0.00s; }
  #job-grid > *:nth-child(2)  { animation-delay: 0.03s; }
  #job-grid > *:nth-child(3)  { animation-delay: 0.06s; }
  #job-grid > *:nth-child(4)  { animation-delay: 0.09s; }
  #job-grid > *:nth-child(5)  { animation-delay: 0.12s; }
  #job-grid > *:nth-child(6)  { animation-delay: 0.15s; }
  #job-grid > *:nth-child(7)  { animation-delay: 0.18s; }
  #job-grid > *:nth-child(8)  { animation-delay: 0.21s; }
  #job-grid > *:nth-child(9)  { animation-delay: 0.24s; }
  #job-grid > *:nth-child(n+10) { animation-delay: 0.27s; }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  /* Animação de saída da grid ao navegar entre páginas */
  #job-grid.leaving {
    animation: gridOut 0.2s ease forwards;
  }
  @keyframes gridOut {
    to { opacity: 0; transform: translateY(-8px); }
  }
</style>

<script>
  // Salva a URL atual com filtros no sessionStorage para navegação de retorno
  if (window.location.search) {
    sessionStorage.setItem('last_vagas_filter_url', window.location.href);
  }

  // Listener para limpar filtros
  const clearFilters = () => sessionStorage.removeItem('last_vagas_filter_url');
  document.getElementById('clear-filters-btn')?.addEventListener('click', clearFilters);
  document.getElementById('clear-filters-card-btn')?.addEventListener('click', clearFilters);

  // Auto-submete o form ao mudar qualquer filtro (type, modality)
  const form = document.getElementById('filter-form') as HTMLFormElement | null;
  const filterSelects = ['select-type', 'select-modality'];
  const submitBtn = form?.querySelector('button[type="submit"]');

  filterSelects.forEach((id) => {
    const select = document.getElementById(id) as HTMLSelectElement | null;
    select?.addEventListener('change', () => {
      // Feedback visual no botão
      if (submitBtn) {
        submitBtn.textContent = 'Filtrando...';
        submitBtn.setAttribute('disabled', 'true');
      }
      // Anima saída da grid antes de submeter
      const grid = document.getElementById('job-grid');
      if (grid) {
        grid.classList.add('leaving');
        setTimeout(() => form?.submit(), 200);
      } else {
        form?.submit();
      }
    });
  });

  // Listener para ordenação
  const sortSelect = document.getElementById('select-sort') as HTMLSelectElement | null;
  sortSelect?.addEventListener('change', () => {
    const currentUrl = new URL(window.location.href);
    currentUrl.searchParams.set('sort', sortSelect.value);
    const grid = document.getElementById('job-grid');
    if (grid) {
      grid.classList.add('leaving');
      setTimeout(() => { window.location.href = currentUrl.toString(); }, 200);
    } else {
      window.location.href = currentUrl.toString();
    }
  });

  // Animação de saída ao clicar em links de paginação
  document.querySelectorAll('.pagination-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const grid = document.getElementById('job-grid');
      if (!grid) return;
      e.preventDefault();
      const href = (link as HTMLAnchorElement).href;
      grid.classList.add('leaving');
      setTimeout(() => { window.location.href = href; }, 210);
    });
  });
</script>
