---

<Layout 
  title="Vagas | estagio.io"
  description="Encontre sua próxima vaga de estágio. Filtre por área, regime e mais."
>
  <div class="pt-24 pb-xl px-gutter max-w-container-max mx-auto w-full">
    <!-- Search Section -->
    <section class="mb-lg">
      <form action="/vagas" method="GET" class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant filter-shadow">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-md items-center">
          <div class="md:col-span-6 relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">search</span>
            <input name="q" class="w-full pl-12 pr-4 py-3 bg-surface border-outline-variant border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface-variant" placeholder="Pesquise por títulos, palavras-chave ou empresas..." type="text"/>
          </div>
          <div class="md:col-span-3 relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">location_on</span>
            <input name="location" class="w-full pl-12 pr-4 py-3 bg-surface border-outline-variant border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface-variant" placeholder="Cidade ou remoto" type="text"/>
          </div>
          <div class="md:col-span-3">
            <button type="submit" class="w-full bg-primary text-on-primary px-xl py-3 rounded-lg font-label-md text-label-md hover:bg-primary-container transition-all flex items-center justify-center gap-sm whitespace-nowrap">
              <span>Buscar Vagas</span>
            </button>
          </div>
        </div>
      </form>
    </section>

    <!-- Horizontal Filter Bar -->
    <section class="mb-xl">
      <div class="flex flex-wrap items-center gap-md">
        <div class="relative group">
          <select class="appearance-none bg-none bg-surface-container-low border border-outline-variant rounded-full pl-md pr-10 py-2 font-label-md text-label-md text-on-surface-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none cursor-pointer transition-all">
            <option disabled="" selected="">Área de Atuação</option>
            <option>Engenharia &amp; Tech</option>
            <option>Design &amp; UX</option>
            <option>Marketing</option>
            <option>Vendas</option>
          </select>
          <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[20px]">expand_more</span>
        </div>
        <div class="relative group">
          <select class="appearance-none bg-none bg-surface-container-low border border-outline-variant rounded-full pl-md pr-10 py-2 font-label-md text-label-md text-on-surface-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none cursor-pointer transition-all">
            <option disabled="" selected="">Tipo de Estágio</option>
            <option>Meio Período</option>
            <option>Período Integral</option>
          </select>
          <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[20px]">expand_more</span>
        </div>
        <div class="relative group">
          <select class="appearance-none bg-none bg-primary-container/20 border border-primary/30 rounded-full pl-md pr-10 py-2 font-label-md text-label-md text-primary focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none cursor-pointer transition-all">
            <option disabled="">Modalidade</option>
            <option selected="">Remoto</option>
            <option>Híbrido</option>
            <option>Presencial</option>
          </select>
          <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-primary pointer-events-none text-[20px]">expand_more</span>
        </div>
        <div class="relative group">
          <select class="appearance-none bg-none bg-surface-container-low border border-outline-variant rounded-full pl-md pr-10 py-2 font-label-md text-label-md text-on-surface-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none cursor-pointer transition-all">
            <option disabled="" selected="">Empresa</option>
            <option>Google</option>
            <option>Nubank</option>
            <option>Stripe</option>
            <option>Lumina Tech</option>
          </select>
          <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[20px]">expand_more</span>
        </div>
        <button class="text-primary font-label-md hover:underline px-sm py-2">Limpar filtros</button>
      </div>
    </section>

    <div class="flex flex-col gap-xl">
      <!-- Main Job Feed -->
      <div class="flex-grow">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-lg gap-md">
          <p class="font-body-sm text-body-sm text-on-surface-variant">Mostrando <span class="font-bold text-on-surface">{jobs.length}</span> oportunidades de estágio</p>
          <div class="flex items-center gap-sm">
            <span class="text-label-sm font-label-sm text-outline">Ordenar por:</span>
            <select class="appearance-none bg-none bg-transparent border-none focus:ring-0 font-label-md text-label-md text-primary cursor-pointer pr-8 py-0 outline-none">
              <option>Mais recentes</option>
              <option>Popularidade</option>
              <option>Bolsa Auxílio</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
          {jobs.map((job) => (
            <JobCard {...job} />
          ))}
        </div>

        <!-- Pagination -->
        <div class="mt-xl flex items-center justify-center gap-sm">
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">chevron_left</span>
          </button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary text-on-primary font-label-md text-label-md">1</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-low transition-colors">2</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-low transition-colors">3</button>
          <span class="px-xs text-outline">...</span>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-low transition-colors">12</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">chevron_right</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>
