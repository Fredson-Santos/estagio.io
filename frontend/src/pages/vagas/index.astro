---

<Layout 
  title="Vagas | estagio.io"
  description="Encontre sua próxima vaga de estágio. Filtre por área, regime e mais."
>
  <div class="pt-24 pb-xl px-gutter max-w-container-max mx-auto w-full">
    <!-- Search Section -->
    <section class="mb-xl">
      <form action="/vagas" method="GET" class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
        <div class="flex flex-col md:flex-row gap-md">
          <div class="flex-grow relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">search</span>
            <input name="q" class="w-full pl-12 pr-4 py-3 bg-surface border-outline-variant border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface-variant" placeholder="Cargo, palavra-chave ou empresa..." type="text">
          </div>
          <div class="relative min-w-[200px]">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">location_on</span>
            <input name="location" class="w-full pl-12 pr-4 py-3 bg-surface border-outline-variant border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface-variant" placeholder="Cidade ou remoto" type="text">
          </div>
          <button type="submit" class="bg-primary text-on-primary px-xl py-3 rounded-lg font-label-md text-label-md hover:bg-primary-container transition-all flex items-center justify-center gap-sm">
            <span>Buscar</span>
          </button>
        </div>
      </form>
    </section>

    <div class="flex flex-col lg:flex-row gap-xl">
      <FilterSidebar />
      
      <!-- Main Job Feed -->
      <div class="flex-grow">
        <div class="flex justify-between items-center mb-lg">
          <p class="font-body-sm text-body-sm text-on-surface-variant">Mostrando <span class="font-bold text-on-surface">{jobs.length}</span> oportunidades</p>
          <div class="flex items-center gap-sm">
            <span class="text-label-sm font-label-sm text-outline">Ordenar por:</span>
            <select class="bg-transparent border-none focus:ring-0 font-label-md text-label-md text-primary cursor-pointer pr-8 outline-none">
              <option>Mais recentes</option>
              <option>Relevância</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
          {jobs.map((job) => (
            <JobCard {...job} />
          ))}
        </div>

        <!-- Pagination -->
        <div class="mt-xl flex items-center justify-center gap-sm">
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">chevron_left</span>
          </button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary text-on-primary font-label-md text-label-md">1</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-low transition-colors">2</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-low transition-colors">3</button>
          <span class="px-xs text-outline">...</span>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-low transition-colors">12</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">chevron_right</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>
