---
import Layout from '../../layouts/Layout.astro';
import JobCard from '../../components/JobCard.astro';

export const prerender = false;

// Pegar os parâmetros de busca da URL para repassar ao backend
const url = new URL(Astro.request.url);
const searchParams = url.searchParams;

// Mapa de tradução de modalidade
const MODALITY_LABELS: Record<string, string> = {
  REMOTE: 'Remoto',
  HYBRID: 'Híbrido',
  ONSITE: 'Presencial',
};

// Mapear parâmetros do frontend para o backend
const query = new URLSearchParams();
if (searchParams.get('q'))        query.append('q',        searchParams.get('q') || '');
if (searchParams.get('location')) query.append('location', searchParams.get('location') || '');
if (searchParams.get('area'))     query.append('area',     searchParams.get('area') || '');
if (searchParams.get('type'))     query.append('type',     searchParams.get('type') || '');
if (searchParams.get('modality')) query.append('modality', searchParams.get('modality') || '');
if (searchParams.get('company'))  query.append('company',  searchParams.get('company') || '');

// Fetch jobs do backend
let jobs = [];
let total = 0;
try {
  const backendUrl = process.env.BACKEND_URL || 'http://localhost:8000';
  const response = await fetch(`${backendUrl}/api/v1/jobs?${query.toString()}`);
  if (response.ok) {
    const data = await response.json();
    jobs = data.items.map((job: any) => ({
      ...job,
      publishedAt: job.posted_at ? new Date(job.posted_at).toLocaleDateString('pt-BR') : 'Recente',
      logo: job.company_logo || undefined,
      modality: MODALITY_LABELS[job.modality] || job.modality || 'Presencial',
    }));
    total = data.total;
  }
} catch (e) {
  console.error("Erro ao buscar vagas do backend", e);
}
---

<Layout 
  title="Vagas | estagio.io"
  description="Encontre sua próxima vaga de estágio. Filtre por área, regime e mais."
>
  <div class="pt-24 pb-xl px-gutter max-w-container-max mx-auto w-full">
    <!-- Search Section -->
    <section class="mb-lg">
      <form action="/vagas" method="GET" class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant filter-shadow" id="filter-form">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-md items-center mb-md">
          <div class="md:col-span-6 relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">search</span>
            <input name="q" value={searchParams.get('q') || ''} class="w-full pl-12 pr-4 py-3 bg-surface border-outline-variant border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface-variant" placeholder="Pesquise por títulos, palavras-chave ou empresas..." type="text"/>
          </div>
          <div class="md:col-span-3 relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">location_on</span>
            <input name="location" value={searchParams.get('location') || ''} class="w-full pl-12 pr-4 py-3 bg-surface border-outline-variant border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface-variant" placeholder="Cidade ou remoto" type="text"/>
          </div>
          <div class="md:col-span-3">
            <button type="submit" class="w-full bg-primary text-on-primary px-xl py-3 rounded-lg font-label-md text-label-md hover:bg-primary-container transition-all flex items-center justify-center gap-sm whitespace-nowrap">
              <span>Buscar Vagas</span>
            </button>
          </div>
        </div>

        <!-- Filtros dentro do form para serem enviados na busca -->
        <div class="flex flex-wrap items-center gap-md pt-md border-t border-outline-variant/30">
          <div class="relative group">
            <select id="select-area" name="area" class="appearance-none bg-none bg-surface-container-low border border-outline-variant rounded-full pl-md pr-10 py-2 font-label-md text-label-md text-on-surface-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none cursor-pointer transition-all">
              <option value="" selected={!searchParams.get('area')}>Área de Atuação</option>
              <option value="TI_SOFTWARE"      selected={searchParams.get('area') === 'TI_SOFTWARE'}>Engenharia &amp; Tech</option>
              <option value="DESIGN"           selected={searchParams.get('area') === 'DESIGN'}>Design &amp; UX</option>
              <option value="MARKETING"        selected={searchParams.get('area') === 'MARKETING'}>Marketing</option>
              <option value="NEGOCIOS"         selected={searchParams.get('area') === 'NEGOCIOS'}>Vendas &amp; Negócios</option>
              <option value="DADOS"            selected={searchParams.get('area') === 'DADOS'}>Dados</option>
              <option value="RH"               selected={searchParams.get('area') === 'RH'}>RH</option>
              <option value="FINANCAS"         selected={searchParams.get('area') === 'FINANCAS'}>Finanças</option>
              <option value="DIREITO"          selected={searchParams.get('area') === 'DIREITO'}>Direito</option>
              <option value="OUTROS"           selected={searchParams.get('area') === 'OUTROS'}>Outros</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[20px]">expand_more</span>
          </div>
          <div class="relative group">
            <select id="select-type" name="type" class="appearance-none bg-none bg-surface-container-low border border-outline-variant rounded-full pl-md pr-10 py-2 font-label-md text-label-md text-on-surface-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none cursor-pointer transition-all">
              <option value="" selected={!searchParams.get('type')}>Tipo de Estágio</option>
              <option value="PART_TIME" selected={searchParams.get('type') === 'PART_TIME'}>Meio Período</option>
              <option value="FULL_TIME" selected={searchParams.get('type') === 'FULL_TIME'}>Período Integral</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[20px]">expand_more</span>
          </div>
          <div class="relative group">
            <select id="select-modality" name="modality" class="appearance-none bg-none bg-surface-container-low border border-outline-variant rounded-full pl-md pr-10 py-2 font-label-md text-label-md text-on-surface-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none cursor-pointer transition-all">
              <option value="" selected={!searchParams.get('modality')}>Modalidade</option>
              <option value="REMOTE"  selected={searchParams.get('modality') === 'REMOTE'}>Remoto</option>
              <option value="HYBRID"  selected={searchParams.get('modality') === 'HYBRID'}>Híbrido</option>
              <option value="ONSITE"  selected={searchParams.get('modality') === 'ONSITE'}>Presencial</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[20px]">expand_more</span>
          </div>
          <a href="/vagas" class="text-primary font-label-md hover:underline px-sm py-2">Limpar filtros</a>
        </div>
      </form>
    </section>

    <div class="flex flex-col gap-xl">
      <!-- Main Job Feed -->
      <div class="flex-grow">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-lg gap-md">
          <p class="font-body-sm text-body-sm text-on-surface-variant">Mostrando <span class="font-bold text-on-surface">{total}</span> oportunidades de estágio</p>
          <div class="flex items-center gap-sm">
            <span class="text-label-sm font-label-sm text-outline">Ordenar por:</span>
            <select class="appearance-none bg-none bg-transparent border-none focus:ring-0 font-label-md text-label-md text-primary cursor-pointer pr-8 py-0 outline-none">
              <option>Mais recentes</option>
              <option>Popularidade</option>
              <option>Bolsa Auxílio</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
          {jobs.map((job) => (
            <JobCard {...job} />
          ))}

          {/* Card CTA para preencher slots vazios na última linha (grid de 3 colunas) */}
          {jobs.length % 3 !== 0 && Array.from({ length: 3 - (jobs.length % 3) }).map(() => (
            <div class="bg-gradient-to-br from-primary/5 to-secondary/5 border-2 border-dashed border-primary/20 rounded-xl p-md flex flex-col items-center justify-center text-center gap-md min-h-[200px] group hover:border-primary/40 hover:from-primary/10 hover:to-secondary/10 transition-all">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                <span class="material-symbols-outlined text-[24px] text-primary">notifications_active</span>
              </div>
              <div>
                <p class="font-label-md text-label-md text-on-surface mb-xs">Quer ser o primeiro a saber?</p>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Ative alertas e receba novas vagas no seu e-mail.</p>
              </div>
              <a href="#" class="inline-flex items-center gap-xs px-md py-2 bg-primary text-on-primary rounded-full font-label-sm text-label-sm hover:brightness-110 transition-all active:scale-95">
                <span class="material-symbols-outlined text-[16px]">add_alert</span>
                Criar alerta
              </a>
            </div>
          ))}
        </div>

        <!-- Pagination -->
        <div class="mt-xl flex items-center justify-center gap-sm">
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">chevron_left</span>
          </button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary text-on-primary font-label-md text-label-md">1</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-low transition-colors">2</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-low transition-colors">3</button>
          <span class="px-xs text-outline">...</span>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-low transition-colors">12</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">chevron_right</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Auto-submete o form ao mudar qualquer filtro (area, type, modality)
  const form = document.getElementById('filter-form') as HTMLFormElement | null;
  const filterSelects = ['select-area', 'select-type', 'select-modality'];
  const submitBtn = form?.querySelector('button[type="submit"]');

  filterSelects.forEach((id) => {
    const select = document.getElementById(id) as HTMLSelectElement | null;
    select?.addEventListener('change', () => {
      // Feedback visual no botão
      if (submitBtn) {
        submitBtn.textContent = 'Filtrando...';
        submitBtn.setAttribute('disabled', 'true');
      }
      form?.submit();
    });
  });
</script>
