---
import Layout from '../../layouts/Layout.astro';
import JobPostingSchema from '../../components/JobPostingSchema.astro';

export function getStaticPaths() {
  return [
    { params: { id: 'p1' } },
    { params: { id: 'p2' } },
    { params: { id: 'p3' } },
    { params: { id: 'p4' } },
    { params: { id: 'p5' } },
    { params: { id: 'p6' } },
    { params: { id: 'p7' } },
    { params: { id: 'p8' } },
  ];
}

const { id } = Astro.params;

// Mock da vaga
const job = {
  title: "Product Design Intern",
  description: "Estamos procurando um estagiário de Design de Produto talentoso para se juntar à nossa equipe...",
  datePosted: new Date().toISOString(),
  employmentType: "INTERN" as const,
  hiringOrganization: {
    name: "Lumina Tech",
    logo: "https://lh3.googleusercontent.com/aida-public/AB6AXuA9huf1HcbKfxiH4BFvY4X6loBmJcxLH0XHCxyca542d652b61oFKoOFUKc31zbTLRNG5ZSd43V4tXqkhkKo_cWxRUj7CqnBOHJ17HNGblFs-cOxc_N6459lOGv8qXay9SrXbq-m8EmGt5dkjUCUziWu31grbI-0UKXfpp49-o0xR7mhaUYRfe1f5OyV49mV-zSKS7HtXE6plN-g_Ua6eSq5Zd7BAUNjqHwcORI8aJK0exmUu3d2kPhtg"
  },
  jobLocation: {
    addressLocality: "San Francisco",
    addressRegion: "CA",
    addressCountry: "US"
  }
};
---

<Layout 
  title={`${job.title} - ${job.hiringOrganization.name} | estagio.io`}
  description={`Vaga para ${job.title} na ${job.hiringOrganization.name}.`}
>
  <JobPostingSchema {...job} />
  
  <div class="pt-24 pb-xl px-gutter max-w-3xl mx-auto w-full">
    <div class="bg-surface-container-lowest p-xl rounded-xl border border-outline-variant">
      <div class="flex items-center gap-md mb-lg">
        <img class="w-16 h-16 object-contain rounded border border-outline-variant/30 p-xs" src={job.hiringOrganization.logo} alt={`Logo ${job.hiringOrganization.name}`} />
        <div>
          <h1 class="font-headline-lg text-headline-lg text-on-surface mb-xs">{job.title}</h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant">{job.hiringOrganization.name}</p>
        </div>
      </div>
      
      <div class="flex flex-wrap items-center gap-md mb-xl border-y border-outline-variant/30 py-md">
        <div class="flex items-center gap-xs text-on-surface-variant">
          <span class="material-symbols-outlined text-[20px]">location_on</span>
          <span class="font-body-md">{job.jobLocation.addressLocality}, {job.jobLocation.addressRegion}</span>
        </div>
        <div class="flex items-center gap-xs text-on-surface-variant">
          <span class="material-symbols-outlined text-[20px]">work</span>
          <span class="font-body-md">Estágio</span>
        </div>
      </div>
      
      <div class="prose prose-on-surface max-w-none mb-xl">
        <h2 class="font-headline-md mb-sm">Sobre a vaga</h2>
        <p class="font-body-md text-on-surface-variant">{job.description}</p>
      </div>
      
      <button class="w-full md:w-auto bg-primary text-on-primary font-label-lg text-label-lg px-xl py-md rounded-lg hover:brightness-110 active:scale-95 transition-all">
        Candidatar-se agora
      </button>
    </div>
  </div>
</Layout>
