---
import Layout from '../../layouts/Layout.astro';
import JobPostingSchema from '../../components/JobPostingSchema.astro';
import { formatModality } from '../../utils/modality';
import { getAreaLabel } from '../../utils/areas';
import { getPlatformName } from '../../utils/platform';
import { fetchJob } from '../../lib/api';
import type { JobWithDisplay } from '../../lib/types';

export const prerender = false;

const { id } = Astro.params;

let job: (JobWithDisplay & { platformName: string }) | null = null;
let jobNotFound = false;

try {
  const data = await fetchJob(id as string);

  const postedAt = data.posted_at ? new Date(data.posted_at) : null;
  const now = new Date();
  let postedLabel = 'Recente';
  if (postedAt) {
    const diffMs = now.getTime() - postedAt.getTime();
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    if (diffDays === 0) postedLabel = 'Hoje';
    else if (diffDays === 1) postedLabel = 'Ontem';
    else if (diffDays < 7) postedLabel = `Há ${diffDays} dias`;
    else postedLabel = postedAt.toLocaleDateString('pt-BR');
  }

  const platformName = getPlatformName(data.source_url, data.source_name);

  job = {
    id: data.id,
    title: data.title,
    company: data.company,
    location: data.location || 'Remoto',
    modality: formatModality(data.modality),
    area: getAreaLabel(data.area),
    description: data.description || '',
    salary: data.salary || null,
    logo: data.company_logo || undefined,
    sourceUrl: data.source_url || '#',
    postedLabel,
    isNew: data.is_new || false,
    datePosted: data.posted_at || new Date().toISOString(),
    platformName,
  };
} catch (e) {
  const err = e as Error;
  if (err.message === 'Backend 404') {
    jobNotFound = true;
  } else {
    console.error('Erro ao buscar detalhes da vaga', e);
    jobNotFound = true;
  }
}

if (jobNotFound || !job) {
  return Astro.redirect('/404', 302);
}


const schemaData = {
  title: job.title,
  description: job.description,
  datePosted: job.datePosted,
  employmentType: 'INTERN' as const,
  hiringOrganization: {
    name: job.company,
    logo: job.logo || 'https://via.placeholder.com/150',
  },
  jobLocation: {
    addressLocality: job.location,
    addressRegion: '',
    addressCountry: 'BR',
  },
};
const currentQuery = Astro.url.searchParams.toString();
const vagasUrl = `/vagas${currentQuery ? `?${currentQuery}` : ''}`;
---

<Layout
  title={`${job.title} - ${job.company} | estagio.io`}
  description={`Vaga de estágio: ${job.title} na ${job.company}. ${job.location}. Candidate-se agora no estagio.io.`}
>
  <JobPostingSchema {...schemaData} />

  <div class="pt-24 pb-16 px-gutter">
    <div class="max-w-container-max mx-auto w-full">

      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-body-sm font-body-sm text-on-surface-variant" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Início</a>
        <span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span>
        <a href={vagasUrl} id="breadcrumb-vagas-link" class="hover:text-primary transition-colors">Vagas</a>
        <span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span>
        <span class="text-on-surface truncate flex-1 min-w-0">{job.title}</span>
      </nav>

      <!-- Job Header Card -->
      <section class="bg-surface-container-lowest rounded-xl border border-outline-variant overflow-hidden mb-6 shadow-sm job-header-card">
        <!-- Accent bar -->
        <div class="h-1.5 bg-primary w-full"></div>

        <div class="p-5 sm:p-6 md:p-8 relative">
          <!-- Share button (top-right corner) -->
          <button
            id="share-btn"
            aria-label="Compartilhar vaga"
            class="absolute top-4 right-4 p-2.5 text-on-surface-variant hover:bg-surface-container-high rounded-full transition-colors"
          >
            <span class="material-symbols-outlined text-[20px]">share</span>
          </button>

          <!-- Main Layout Container -->
          <div class="flex flex-col gap-5">

            <!-- Top Row: Logo + Title & Company -->
            <div class="flex items-start gap-3.5 pr-8">
              {job.logo ? (
                <img
                  src={job.logo}
                  alt={`Logo ${job.company}`}
                  class="w-12 h-12 sm:w-14 sm:h-14 object-contain rounded-xl border border-outline-variant/40 p-1.5 bg-white flex-shrink-0"
                />
              ) : (
                <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl border border-outline-variant/40 bg-primary/10 flex items-center justify-center flex-shrink-0">
                  <span class="font-bold text-primary text-lg sm:text-xl">{job.company.substring(0, 2).toUpperCase()}</span>
                </div>
              )}

              <div class="flex-1 min-w-0">
                <!-- Title -->
                <h1 class="text-lg sm:text-2xl font-bold text-on-surface leading-snug mb-1.5">
                  {job.title}
                </h1>

                <!-- Company & Badges -->
                <div class="flex flex-wrap items-center gap-2 text-body-sm">
                  <span class="font-medium text-on-surface-variant flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px] text-outline">business</span>
                    {job.company}
                  </span>
                  <span class="text-outline/30">•</span>
                  <span class="bg-secondary-container/60 text-on-secondary-container text-xs px-2.5 py-0.5 rounded-full font-medium inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-[12px]">label</span>
                    {job.area}
                  </span>
                  {job.isNew && (
                    <span class="bg-primary/10 text-primary text-xs px-2.5 py-0.5 rounded-full font-semibold">
                      Novo
                    </span>
                  )}
                </div>
              </div>
            </div>

            <!-- Metadata Pills Row -->
            <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2 text-body-sm text-on-surface-variant pt-3 border-t border-outline-variant/20">
              <div class="flex items-center gap-2 bg-surface-container-low/60 px-3 py-2 rounded-lg border border-outline-variant/30">
                <span class="material-symbols-outlined text-[18px] text-primary flex-shrink-0">apartment</span>
                <span class="font-medium text-xs sm:text-sm truncate">{job.modality}</span>
              </div>
              <div class="flex items-center gap-2 bg-surface-container-low/60 px-3 py-2 rounded-lg border border-outline-variant/30">
                <span class="material-symbols-outlined text-[18px] text-primary flex-shrink-0">location_on</span>
                <span class="font-medium text-xs sm:text-sm truncate">{job.location}</span>
              </div>
              <div class="flex items-center gap-2 bg-surface-container-low/60 px-3 py-2 rounded-lg border border-outline-variant/30 col-span-2 sm:col-auto">
                <span class="font-medium text-xs sm:text-sm truncate">Via {job.platformName}</span>
              </div>
              {job.salary && (
                <div class="flex items-center gap-2 bg-surface-container-low/60 px-3 py-2 rounded-lg border border-outline-variant/30 col-span-2 sm:col-auto">
                  <span class="material-symbols-outlined text-[18px] text-primary flex-shrink-0">payments</span>
                  <span class="font-medium text-xs sm:text-sm truncate">{job.salary}</span>
                </div>
              )}
              <div class="flex items-center gap-2 bg-surface-container-low/60 px-3 py-2 rounded-lg border border-outline-variant/30 col-span-2 sm:col-auto">
                <span class="material-symbols-outlined text-[18px] text-primary flex-shrink-0">schedule</span>
                <span class="font-medium text-xs sm:text-sm truncate">{job.postedLabel}</span>
              </div>
            </div>

            <!-- Action Buttons (Full width on mobile) -->
            <div class="pt-2 border-t border-outline-variant/30 flex flex-col sm:flex-row gap-3 w-full">
              <a
                id="apply-btn"
                href={job.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary text-on-primary rounded-xl font-medium text-body-md hover:brightness-110 active:scale-[0.98] transition-all shadow-sm"
              >
                <span class="material-symbols-outlined text-[20px]">open_in_new</span>
                Candidatar-se na {job.platformName}
              </a>
              <button
                id="copy-link-btn"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 bg-surface-container border border-outline-variant text-on-surface rounded-xl font-medium text-body-md hover:bg-surface-container-high active:scale-[0.98] transition-all"
              >
                <span class="material-symbols-outlined text-[20px]">link</span>
                Copiar link
              </button>
            </div>

          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .job-header-card {
    animation: slideUp 0.4s ease both;
  }
  .job-desc-card {
    animation: slideUp 0.4s ease 0.1s both;
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  /* Estilização para o HTML da descrição vinda de fontes como Gupy/Eureca */
  .description-content {
    line-height: 1.75;
  }
  .description-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .description-content :global(h1),
  .description-content :global(h2),
  .description-content :global(h3),
  .description-content :global(h4),
  .description-content :global(h5),
  .description-content :global(h6) {
    color: var(--color-on-surface);
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }
  .description-content :global(ul),
  .description-content :global(ol) {
    margin-left: 1.25rem;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    list-style-type: disc;
  }
  .description-content :global(ol) {
    list-style-type: decimal;
  }
  .description-content :global(li) {
    margin-bottom: 0.35rem;
    line-height: 1.6;
  }
  .description-content :global(strong),
  .description-content :global(b) {
    color: var(--color-on-surface);
    font-weight: 600;
  }
  .description-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>

<script>
  // Restaura URL de busca salva no breadcrumb se o link padrão estiver sem params
  const savedVagasUrl = sessionStorage.getItem('last_vagas_filter_url');
  if (savedVagasUrl) {
    const breadcrumbLink = document.getElementById('breadcrumb-vagas-link') as HTMLAnchorElement | null;
    if (breadcrumbLink && (breadcrumbLink.getAttribute('href') === '/vagas' || !breadcrumbLink.href.includes('?'))) {
      breadcrumbLink.href = savedVagasUrl;
    }
  }

  // Share button
  const shareBtn = document.getElementById('share-btn');
  const copyLinkBtn = document.getElementById('copy-link-btn');
  const currentUrl = window.location.href;

  function copyToClipboard() {
    navigator.clipboard.writeText(currentUrl).then(() => {
      const btn = copyLinkBtn;
      if (!btn) return;
      const icon = btn.querySelector('.material-symbols-outlined');
      if (icon) icon.textContent = 'check';
      btn.innerHTML = `<span class="material-symbols-outlined text-[20px]">check</span> Link copiado!`;
      setTimeout(() => {
        btn.innerHTML = `<span class="material-symbols-outlined text-[20px]">link</span> Copiar link`;
      }, 2000);
    });
  }

  shareBtn?.addEventListener('click', () => {
    if (navigator.share) {
      navigator.share({ url: currentUrl, title: document.title });
    } else {
      copyToClipboard();
    }
  });

  copyLinkBtn?.addEventListener('click', copyToClipboard);
</script>
