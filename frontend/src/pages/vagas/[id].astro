---
import Layout from '../../layouts/Layout.astro';
import JobPostingSchema from '../../components/JobPostingSchema.astro';
import { formatModality } from '../../utils/modality';
import { formatJobDescription } from '../../utils/formatDescription';

export const prerender = false;

const { id } = Astro.params;

let job: any = null;

const AREA_LABELS: Record<string, string> = {
  TI_SOFTWARE: 'TI & Software',
  DADOS: 'Dados',
  DESIGN: 'Design',
  MARKETING: 'Marketing',
  NEGOCIOS: 'Negócios',
  RH: 'RH',
  FINANCAS: 'Finanças',
  ENGENHARIA_OUTRAS: 'Engenharia',
  DIREITO: 'Direito',
  OUTROS: 'Outros',
};

try {
  const backendUrl = (import.meta as any).env?.BACKEND_URL || 'http://localhost:8000';
  const response = await fetch(`${backendUrl}/api/v1/jobs/${id}`);
  if (response.ok) {
    const data = await response.json();

    const postedAt = data.posted_at ? new Date(data.posted_at) : null;
    const now = new Date();
    let postedLabel = 'Recente';
    if (postedAt) {
      const diffMs = now.getTime() - postedAt.getTime();
      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      if (diffDays === 0) postedLabel = 'Hoje';
      else if (diffDays === 1) postedLabel = 'Ontem';
      else if (diffDays < 7) postedLabel = `Há ${diffDays} dias`;
      else postedLabel = postedAt.toLocaleDateString('pt-BR');
    }

    job = {
      id: data.id,
      title: data.title,
      company: data.company,
      location: data.location || 'Remoto',
      modality: formatModality(data.modality),
      area: AREA_LABELS[data.area] || data.area || 'Outros',
      description: data.description || '',
      salary: data.salary || null,
      logo: data.company_logo || null,
      sourceUrl: data.source_url || '#',
      postedLabel,
      isNew: data.is_new || false,
      datePosted: data.posted_at || new Date().toISOString(),
    };
  } else if (response.status === 404) {
    return Astro.redirect('/404');
  }
} catch (e) {
  console.error('Erro ao buscar detalhes da vaga', e);
}

if (!job) {
  return Astro.redirect('/404');
}

const formattedDescription = formatJobDescription(job.description);

const schemaData = {
  title: job.title,
  description: job.description,
  datePosted: job.datePosted,
  employmentType: 'INTERN' as const,
  hiringOrganization: {
    name: job.company,
    logo: job.logo || 'https://via.placeholder.com/150',
  },
  jobLocation: {
    addressLocality: job.location,
    addressRegion: '',
    addressCountry: 'BR',
  },
};
---

<Layout
  title={`${job.title} - ${job.company} | estagio.io`}
  description={`Vaga de estágio: ${job.title} na ${job.company}. ${job.location}. Candidate-se agora no estagio.io.`}
>
  <JobPostingSchema {...schemaData} />

  <div class="pt-24 pb-16 px-gutter">
    <div class="max-w-container-max mx-auto w-full">

      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-body-sm font-body-sm text-on-surface-variant" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Início</a>
        <span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span>
        <a href="/vagas" class="hover:text-primary transition-colors">Vagas</a>
        <span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span>
        <span class="text-on-surface line-clamp-1 max-w-[200px] md:max-w-xs">{job.title}</span>
      </nav>

      <!-- Job Header Card -->
      <section class="bg-surface-container-lowest rounded-xl border border-outline-variant overflow-hidden mb-6 shadow-sm job-header-card">
        <!-- Accent bar -->
        <div class="h-1.5 bg-primary w-full"></div>

        <div class="p-6 md:p-8">
          <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">

            <!-- Left: title, company, meta -->
            <div class="space-y-3 flex-1">

              <!-- Title row -->
              <div class="flex flex-wrap items-start gap-3">
                {job.logo ? (
                  <img
                    src={job.logo}
                    alt={`Logo ${job.company}`}
                    class="w-14 h-14 object-contain rounded-full border border-outline-variant/40 p-1 bg-white flex-shrink-0"
                  />
                ) : (
                  <div class="w-14 h-14 rounded-full border border-outline-variant/40 bg-primary/10 flex items-center justify-center flex-shrink-0">
                    <span class="font-bold text-primary text-xl">{job.company.substring(0, 2).toUpperCase()}</span>
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <h1 class="text-headline-lg font-headline-lg text-on-surface leading-tight">{job.title}</h1>

                    <!-- Share button -->
                    <button
                      id="share-btn"
                      aria-label="Compartilhar vaga"
                      class="p-1.5 text-on-surface-variant hover:bg-surface-container-high rounded-full transition-colors flex-shrink-0"
                    >
                      <span class="material-symbols-outlined text-[20px]">share</span>
                    </button>

                    <!-- Area badge -->
                    <span class="bg-secondary-container/60 text-on-secondary-container text-label-sm font-label-sm px-sm py-xs rounded-full flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px]">label</span>
                      {job.area}
                    </span>

                    {job.isNew && (
                      <span class="bg-primary/10 text-primary text-label-sm font-label-sm px-sm py-xs rounded-full font-semibold">
                        Novo
                      </span>
                    )}
                  </div>

                  <!-- Company -->
                  <p class="text-on-surface-variant font-body-md text-body-md flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">business</span>
                    {job.company}
                  </p>
                </div>
              </div>

              <!-- Metadata chips row -->
              <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-body-sm font-body-sm text-on-surface-variant pt-1">
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[18px] text-primary">apartment</span>
                  <span>{job.modality}</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[18px] text-primary">location_on</span>
                  <span>{job.location}</span>
                </div>
                {job.salary && (
                  <div class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px] text-primary">payments</span>
                    <span>{job.salary}</span>
                  </div>
                )}
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[18px] text-primary">schedule</span>
                  <span>{job.postedLabel}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Divider + CTA -->
          <hr class="my-6 border-outline-variant/30" />
          <div class="flex flex-wrap gap-3 justify-center md:justify-start">
            <a
              id="apply-btn"
              href={job.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-on-primary rounded-lg font-label-md text-label-md hover:brightness-110 active:scale-95 transition-all shadow-sm"
            >
              <span class="material-symbols-outlined text-[20px]">open_in_new</span>
              Candidatar-se agora
            </a>
            <button
              id="copy-link-btn"
              class="inline-flex items-center gap-2 px-5 py-3 bg-surface-container border border-outline-variant text-on-surface rounded-lg font-label-md text-label-md hover:bg-surface-container-high active:scale-95 transition-all"
            >
              <span class="material-symbols-outlined text-[20px]">link</span>
              Copiar link
            </button>
          </div>
        </div>
      </section>

      <!-- Description Card -->
      <section class="bg-surface-container-lowest rounded-xl border border-outline-variant p-6 md:p-8 shadow-sm job-desc-card">
        <div class="prose-job">

          <!-- Descrição da vaga -->
          {formattedDescription && (
            <div class="mb-8">
              <h2 class="text-headline-sm font-headline-sm text-on-surface mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-[22px] text-primary">description</span>
                Descrição da vaga
              </h2>
              <div class="text-on-surface-variant font-body-md text-body-md leading-relaxed description-content" set:html={formattedDescription} />
            </div>
          )}

          <!-- Back to list -->
          <div class="pt-6 border-t border-outline-variant/30 flex flex-col sm:flex-row gap-3">
            <a
              href={job.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary text-on-primary rounded-lg font-label-md text-label-md hover:brightness-110 active:scale-95 transition-all"
            >
              <span class="material-symbols-outlined text-[20px]">open_in_new</span>
              Candidatar-se agora
            </a>
            <a
              href="/vagas"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-surface-container border border-outline-variant text-on-surface rounded-lg font-label-md text-label-md hover:bg-surface-container-high active:scale-95 transition-all"
            >
              <span class="material-symbols-outlined text-[20px]">arrow_back</span>
              Ver outras vagas
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .job-header-card {
    animation: slideUp 0.4s ease both;
  }
  .job-desc-card {
    animation: slideUp 0.4s ease 0.1s both;
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  /* Estilização para o HTML da descrição vinda de fontes como Gupy/Eureca */
  .description-content {
    line-height: 1.75;
  }
  .description-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .description-content :global(h1),
  .description-content :global(h2),
  .description-content :global(h3),
  .description-content :global(h4),
  .description-content :global(h5),
  .description-content :global(h6) {
    color: var(--color-on-surface);
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }
  .description-content :global(ul),
  .description-content :global(ol) {
    margin-left: 1.25rem;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    list-style-type: disc;
  }
  .description-content :global(ol) {
    list-style-type: decimal;
  }
  .description-content :global(li) {
    margin-bottom: 0.35rem;
    line-height: 1.6;
  }
  .description-content :global(strong),
  .description-content :global(b) {
    color: var(--color-on-surface);
    font-weight: 600;
  }
  .description-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>

<script>
  // Share button
  const shareBtn = document.getElementById('share-btn');
  const copyLinkBtn = document.getElementById('copy-link-btn');
  const currentUrl = window.location.href;

  function copyToClipboard() {
    navigator.clipboard.writeText(currentUrl).then(() => {
      const btn = copyLinkBtn;
      if (!btn) return;
      const icon = btn.querySelector('.material-symbols-outlined');
      if (icon) icon.textContent = 'check';
      btn.innerHTML = `<span class="material-symbols-outlined text-[20px]">check</span> Link copiado!`;
      setTimeout(() => {
        btn.innerHTML = `<span class="material-symbols-outlined text-[20px]">link</span> Copiar link`;
      }, 2000);
    });
  }

  shareBtn?.addEventListener('click', () => {
    if (navigator.share) {
      navigator.share({ url: currentUrl, title: document.title });
    } else {
      copyToClipboard();
    }
  });

  copyLinkBtn?.addEventListener('click', copyToClipboard);
</script>
