---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SearchBar from '../components/SearchBar.tsx';
import FilterBar from '../components/FilterBar.tsx';
import JobCard from '../components/JobCard.astro';

let jobs = [];
let total = 0;

try {
  const res = await fetch('http://127.0.0.1:8000/api/v1/jobs');
  if (res.ok) {
    const data = await res.json();
    jobs = data.items || [];
    total = data.total || 0;
  }
} catch (e) {
  console.error("Erro ao buscar vagas:", e);
}

// Helper para calcular dias atrás
function timeAgo(dateString: string) {
  if (!dateString) return 'recente';
  const diff = Math.floor((new Date().getTime() - new Date(dateString).getTime()) / (1000 * 60 * 60 * 24));
  if (diff === 0) return 'hoje';
  if (diff === 1) return 'ontem';
  return `há ${diff} dias`;
}
---

<MainLayout title="estagio.io - Encontre seu estágio">
  <Header />
  
  <main>
    <Hero />
    
    <div class="container">
      <SearchBar client:load />
      <FilterBar client:load />
      
      <div class="results-header">
        <p>{total} vagas encontradas</p>
      </div>
      
      <div id="job-container" class="job-grid">
        {jobs.length > 0 ? (
          jobs.map((job: any) => (
            <JobCard 
              id={job.id}
              initial={job.company ? job.company.charAt(0).toUpperCase() : 'V'}
              source={job.source_url.includes('vagas.com') ? 'Vagas.com' : 'Gupy'}
              title={job.title}
              company={job.company}
              location={job.location || 'Brasil'}
              modality={job.modality === 'REMOTE' ? 'Remoto' : (job.modality === 'HYBRID' ? 'Híbrido' : 'Presencial')}
              timeAgo={timeAgo(job.posted_at)}
            />
          ))
        ) : (
          <div style="text-align: center; grid-column: 1 / -1; padding: 40px; color: var(--c-muted-foreground)">
            Nenhuma vaga encontrada no momento. Tente novamente mais tarde.
          </div>
        )}
      </div>

      <div class="pagination">
        <button class="page-btn nav-btn" disabled aria-label="Página anterior">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="page-btn active">1</button>
        <button class="page-btn">2</button>
        <button class="page-btn">3</button>
        <button class="page-btn nav-btn" aria-label="Próxima página">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </main>
  
  <footer class="footer">
    <div class="container footer-content">
      <div class="logo">
        <a href="/">estagio.io <span>&copy; {new Date().getFullYear()} Todos os direitos reservados.</span></a>
      </div>
      <nav class="nav-links">
        <a href="/">vagas</a>
        <a href="/sobre">sobre</a>
      </nav>
    </div>
  </footer>
</MainLayout>

<style>
  .results-header {
    margin-bottom: 16px;
    margin-top: 28px;
    color: var(--c-muted-foreground);
    font-size: 14px;
  }

  .job-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-bottom: 80px;
  }

  .page-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--c-muted-foreground);
    border: 1px solid transparent;
    transition: all 0.2s;
    background: transparent;
    cursor: pointer;
  }

  .page-btn:hover:not(:disabled) {
    background: var(--c-secondary);
    color: var(--c-foreground);
  }

  .page-btn.active {
    background: var(--c-primary);
    color: #ffffff; /* primary-foreground equivalent */
    border-color: var(--c-primary);
  }

  .page-btn.nav-btn {
    border-color: var(--c-border);
    background: var(--c-card);
  }

  .page-btn.nav-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }


  .footer {
    border-top: 1px solid var(--c-border);
    padding: 32px 0;
    margin-top: auto;
  }
  
  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  
  .footer .logo a {
    font-weight: 700;
  }
  
  .footer .logo a span {
    font-weight: 400;
    color: var(--c-text-light);
  }
  
  .footer .nav-links {
    display: flex;
    gap: 24px;
  }
  
  .footer .nav-links a {
    color: var(--c-text-light);
  }
  
  .footer .nav-links a:hover {
    color: var(--c-text);
  }

  @media (max-width: 768px) {
    .job-grid {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 24px;
    }

    .results-header {
      margin-top: 20px;
      margin-bottom: 12px;
      font-size: 13px;
    }

    .pagination {
      margin-bottom: 40px;
      gap: 4px;
    }

    .page-btn {
      width: 32px;
      height: 32px;
      font-size: 13px;
    }

    .footer {
      padding: 24px 0;
    }

    .footer-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .footer .logo a {
      font-size: 14px;
    }

    .footer .logo a span {
      display: block;
      font-size: 12px;
      margin-top: 4px;
    }

    .footer .nav-links {
      gap: 16px;
    }

    .footer .nav-links a {
      font-size: 13px;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .job-grid {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    }
  }
</style>
