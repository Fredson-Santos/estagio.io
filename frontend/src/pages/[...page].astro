---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SearchBar from '../components/SearchBar.tsx';
import FilterBar from '../components/FilterBar.tsx';
import JobCard from '../components/JobCard.astro';

export async function getStaticPaths({ paginate }) {
  let jobs = [];
  try {
    const res = await fetch('http://127.0.0.1:8000/api/v1/jobs?limit=5000');
    if (res.ok) {
      const data = await res.json();
      jobs = data.items || [];
    }
  } catch (e) {
    console.error("Erro ao buscar vagas:", e);
  }
  return paginate(jobs, { pageSize: 24 });
}

const { page } = Astro.props;
const jobs = page.data;
const total = page.total;

// Helper para calcular dias atrás
function timeAgo(dateString: string) {
  if (!dateString) return 'recente';
  const jobDate = new Date(dateString);
  const diff = Math.floor((new Date().getTime() - jobDate.getTime()) / (1000 * 60 * 60 * 24));
  if (diff <= 0) return 'hoje';
  if (diff === 1) return 'ontem';
  return `há ${diff} dias`;
}
---

<MainLayout title="estagio.io - Encontre seu estágio">
  <Header />
  
  <main>
    <Hero />
    
    <div class="container">
      <SearchBar client:load />
      <FilterBar client:load />
      
      <div class="results-header">
        <p>{total} vagas encontradas</p>
      </div>
      
      <div id="job-container" class="job-grid">
        {jobs.length > 0 ? (
          jobs.map((job: any) => (
            <JobCard 
              id={job.id}
              initial={job.company ? job.company.charAt(0).toUpperCase() : 'V'}
              source={job.source_url.includes('vagas.com') ? 'Vagas.com' : 'Gupy'}
              title={job.title}
              company={job.company}
              location={job.location || 'Brasil'}
              modality={job.modality === 'REMOTE' ? 'Remoto' : (job.modality === 'HYBRID' ? 'Híbrido' : 'Presencial')}
              timeAgo={timeAgo(job.posted_at)}
            />
          ))
        ) : (
          <div style="text-align: center; grid-column: 1 / -1; padding: 40px; color: var(--c-muted-foreground)">
            Nenhuma vaga encontrada no momento. Tente novamente mais tarde.
          </div>
        )}
      </div>

      <div class="pagination">
        <a href={page.url.prev || '#'} class={`page-btn nav-btn ${!page.url.prev ? 'disabled' : ''}`} aria-label="Página anterior">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </a>
        
        {Array.from({ length: Math.min(5, page.lastPage) }).map((_, i) => {
           let pageNum;
           if (page.lastPage <= 5) {
             pageNum = i + 1;
           } else if (page.currentPage <= 3) {
             pageNum = i + 1;
           } else if (page.currentPage >= page.lastPage - 2) {
             pageNum = page.lastPage - 4 + i;
           } else {
             pageNum = page.currentPage - 2 + i;
           }
           
           const pageUrl = pageNum === 1 ? '/' : `/${pageNum}`;
           return (
             <a href={pageUrl} class={`page-btn ${pageNum === page.currentPage ? 'active' : ''}`}>
               {pageNum}
             </a>
           )
        })}

        <a href={page.url.next || '#'} class={`page-btn nav-btn ${!page.url.next ? 'disabled' : ''}`} aria-label="Próxima página">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </main>
  
  <footer class="footer">
    <div class="container footer-content">
      <div class="logo">
        <a href="/">estagio.io <span>&copy; {new Date().getFullYear()} Todos os direitos reservados.</span></a>
      </div>
      <nav class="nav-links">
        <a href="/">vagas</a>
        <a href="/sobre">sobre</a>
      </nav>
    </div>
  </footer>
</MainLayout>

<style>
  .results-header {
    margin-bottom: 16px;
    margin-top: 28px;
    color: var(--c-muted-foreground);
    font-size: 14px;
  }

  .job-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-bottom: 80px;
  }

  .page-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--c-muted-foreground);
    border: 1px solid transparent;
    transition: all 0.2s;
    background: transparent;
    cursor: pointer;
    text-decoration: none;
  }

  .page-btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .page-btn:hover:not(.disabled) {
    background: var(--c-secondary);
    color: var(--c-foreground);
  }

  .page-btn.active {
    background: var(--c-primary);
    color: var(--c-primary-foreground);
    border-color: var(--c-primary);
  }

  .page-btn.nav-btn {
    background: var(--c-card);
    border-color: var(--c-border);
  }

  .page-btn.nav-btn:hover:not(.disabled) {
    background: var(--c-secondary);
    border-color: var(--c-secondary);
  }
  
  .footer {
    border-top: 1px solid var(--c-border);
    padding: 32px 0;
    margin-top: 80px;
  }
  
  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .footer .logo a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    font-size: 20px;
    font-weight: 700;
    color: var(--c-foreground);
  }
  
  .footer .logo span {
    font-size: 12px;
    font-weight: 400;
    color: var(--c-muted-foreground);
    margin-top: 4px;
  }
  
  .footer .nav-links {
    display: flex;
    gap: 24px;
  }
  
  .footer .nav-links a {
    color: var(--c-muted-foreground);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }
  
  .footer .nav-links a:hover {
    color: var(--c-foreground);
  }
  
  @media (max-width: 768px) {
    .job-grid {
      grid-template-columns: 1fr;
    }
    
    .footer-content {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }
  }
</style>
