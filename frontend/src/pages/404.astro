---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página não encontrada | estagio.io"
  description="A página que você está procurando não existe ou foi movida."
>
  <div class="min-h-[70vh] flex items-center justify-center pt-24 pb-xl px-gutter">
    <div class="max-w-md w-full text-center space-y-md">
      <div class="w-24 h-24 bg-primary/10 rounded-full flex items-center justify-center mx-auto text-primary">
        <span class="material-symbols-outlined text-6xl">search_off</span>
      </div>

      <h1 class="font-display text-display text-on-surface">404</h1>
      <h2 class="font-headline-md text-headline-md text-on-surface">Página não encontrada</h2>

      <p class="font-body-md text-body-md text-on-surface-variant">
        A página ou vaga que você está procurando não existe, foi encerrada ou movida para outro endereço.
      </p>

      <div class="pt-md flex flex-col sm:flex-row gap-sm justify-center">
        <a 
          href="/vagas" 
          class="inline-flex items-center justify-center gap-xs bg-primary text-on-primary px-xl py-3 rounded-lg font-label-md hover:bg-primary-container active:scale-95 transition-all shadow-sm"
        >
          <span class="material-symbols-outlined text-[20px]">work</span>
          Explorar Vagas
        </a>
        <a 
          href="/" 
          class="inline-flex items-center justify-center gap-xs bg-surface-container border border-outline-variant text-on-surface px-xl py-3 rounded-lg font-label-md hover:bg-surface-container-high active:scale-95 transition-all"
        >
          <span class="material-symbols-outlined text-[20px]">home</span>
          Página Inicial
        </a>
      </div>
    </div>
  </div>
</Layout>
