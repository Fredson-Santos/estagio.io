---
import { getBackendUrl, getAdminApiKey } from '../../../../lib/api';

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  return new Response(JSON.stringify({ detail: 'id obrigatório' }), {
    status: 400,
    headers: { 'Content-Type': 'application/json' },
  });
}

const method = Astro.request.method.toUpperCase();
const backendUrl = getBackendUrl();
const apiKey = getAdminApiKey();

let backendMethod = method;
let body: BodyInit | null = null;
const headers: Record<string, string> = {
  'X-Admin-Key': apiKey,
  Accept: 'application/json',
};

if (method === 'DELETE') {
  // repassa direto
} else if (method === 'PATCH' || method === 'POST') {
  backendMethod = 'PATCH';
  const raw = await Astro.request.text();
  body = raw;
  headers['Content-Type'] = 'application/json';
} else {
  return new Response(JSON.stringify({ detail: 'Método não permitido' }), {
    status: 405,
    headers: { 'Content-Type': 'application/json' },
  });
}

try {
  const upstream = await fetch(`${backendUrl}/api/v1/jobs/${id}`, {
    method: backendMethod,
    headers,
    body,
    signal: AbortSignal.timeout(15000),
  });

  if (upstream.status === 204) {
    return new Response(null, { status: 204 });
  }

  return new Response(await upstream.text(), {
    status: upstream.status,
    headers: { 'Content-Type': upstream.headers.get('content-type') || 'application/json' },
  });
} catch (err) {
  return new Response(JSON.stringify({ detail: 'erro de proxy', error: String(err) }), {
    status: 502,
    headers: { 'Content-Type': 'application/json' },
  });
}
---
