---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import ApplyButton from '../../components/ApplyButton.tsx';

export async function getStaticPaths() {
  let jobs = [];
  try {
    const res = await fetch('http://127.0.0.1:8000/api/v1/jobs?limit=100');
    if (res.ok) {
      const data = await res.json();
      jobs = data.items || [];
    }
  } catch(e) {
    console.error("Build time fetch error", e);
  }
  
  return jobs.map((job: any) => ({
    params: { id: job.id },
    props: { job },
  }));
}

const { id } = Astro.params;
const { job } = Astro.props;

// Schema Org JobPosting
const schemaData = {
  "@context": "https://schema.org/",
  "@type": "JobPosting",
  "title": job.title,
  "description": job.description || job.title,
  "hiringOrganization" : {
    "@type": "Organization",
    "name": job.company
  },
  "jobLocation": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": job.location || "Brasil",
      "addressCountry": "BR"
    }
  },
  "datePosted": job.posted_at || new Date().toISOString(),
  "employmentType": "INTERN"
};
---

<MainLayout title={`${job.title} na ${job.company} - estagio.io`}>
  <Header />
  
  <!-- Injetar Schema JSON-LD para SEO no Google Jobs -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  
  <main class="job-detail-main">
    <div class="container">
      <div class="job-detail-card">
        <header class="detail-header">
          <h1>{job.title}</h1>
          <p class="company">{job.company}</p>
          <div class="tags">
            <span class="tag">{job.modality === 'REMOTE' ? 'Remoto' : (job.modality === 'HYBRID' ? 'Híbrido' : 'Presencial')}</span>
            <span class="tag">{job.location || 'Brasil'}</span>
            <span class="tag">{job.area}</span>
          </div>
        </header>
        
        <div class="detail-body">
          <h2>Sobre a vaga</h2>
          <div class="description-content">
            {job.description ? <p>{job.description}</p> : <p>Esta vaga não possui descrição detalhada capturada, acesse o link original para ler os detalhes completos.</p>}
          </div>
        </div>
        
        <div class="detail-footer">
           <ApplyButton client:load jobId={job.id} sourceUrl={job.source_url} />
        </div>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .job-detail-main {
    padding: 60px 0;
  }
  .job-detail-card {
    max-width: 800px;
    margin: 0 auto;
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-xl);
    padding: 40px;
  }
  .detail-header h1 {
    font-size: 32px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--c-primary);
  }
  .detail-header .company {
    font-size: 20px;
    color: var(--c-muted-foreground);
    margin-bottom: 24px;
  }
  .tags {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .tag {
    background: var(--c-secondary);
    color: var(--c-secondary-foreground);
    padding: 6px 12px;
    border-radius: var(--radius);
    font-size: 14px;
    font-weight: 500;
  }
  .detail-body h2 {
    font-size: 24px;
    margin-bottom: 16px;
  }
  .description-content {
    line-height: 1.6;
    color: var(--c-text);
    white-space: pre-wrap;
    margin-bottom: 40px;
  }
  .detail-footer {
    display: flex;
    justify-content: flex-start;
    border-top: 1px solid var(--c-border);
    padding-top: 32px;
  }
</style>
