---
import { formatModality } from '../utils/modality';

interface Props {
  id: string;
  title: string;
  company: string;
  location: string;
  modality?: string;
  salary?: string;
  logo?: string;
  isNew?: boolean;
  publishedAt?: string;
}

const { id, title, company, location, modality, salary, logo, isNew = false, publishedAt } = Astro.props;
const displayModality = formatModality(modality);

// Sanitiza visualmente o salário para ignorar objetos stringificados
const isValidSalary = salary && 
  typeof salary === 'string' && 
  !salary.startsWith('{') && 
  !salary.toLowerCase().includes('undisclosed') && 
  !salary.toLowerCase().includes('display') &&
  salary.trim() !== '';

const companyInitials = (company || 'VA').substring(0, 2).toUpperCase();
---

<a href={`/vagas/${id}`} class="block bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex flex-col transition-all hover:filter-shadow group cursor-pointer h-full relative" style="transform: translateY(0px);">
  <div class="flex justify-between items-start mb-md">
    <div class="w-10 h-10 rounded-full border border-outline-variant overflow-hidden flex-shrink-0 bg-primary/10 flex items-center justify-center relative">
      {logo ? (
        <>
          <img 
            class="w-full h-full object-cover" 
            alt={`Logo ${company}`} 
            src={logo} 
            onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');" 
          />
          <div class="w-full h-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm hidden">
            {companyInitials}
          </div>
        </>
      ) : (
        <div class="w-full h-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">
          {companyInitials}
        </div>
      )}
    </div>
    <div class="flex items-center gap-xs">
      {isNew && (
        <span class="bg-primary/10 text-primary text-label-sm font-label-sm px-sm py-xs rounded-full font-semibold">
          Novo
        </span>
      )}
      <span class="bg-secondary-container/50 text-on-secondary-container px-sm py-xs rounded-full text-label-sm font-label-sm">
        {displayModality}
      </span>
    </div>
  </div>
  <h3 class="font-headline-sm text-headline-sm text-on-surface mb-sm group-hover:text-primary transition-colors line-clamp-2 min-h-[56px]">{title}</h3>
  <div class="flex flex-col gap-xs text-on-surface-variant text-body-sm font-body-sm mb-lg">
    <span class="flex items-center gap-xs">
      <span class="material-symbols-outlined text-[16px]">business</span>
      <span class="line-clamp-1">{company}</span>
    </span>
    <span class="flex items-center gap-xs">
      <span class="material-symbols-outlined text-[16px]">location_on</span>
      <span class="line-clamp-1">{location}</span>
    </span>
    {isValidSalary && (
      <span class="flex items-center gap-xs">
        <span class="material-symbols-outlined text-[16px]">payments</span>
        <span>{salary}</span>
      </span>
    )}
  </div>
  <div class="mt-auto pt-md border-t border-outline-variant/30 flex flex-wrap justify-between items-center gap-md">
    <span class="text-label-sm font-label-sm text-outline">{publishedAt || 'Recente'}</span>
    <span class="bg-primary text-on-primary px-lg py-2.5 rounded-lg font-label-md text-label-md group-hover:bg-primary-container transition-all active:scale-95 whitespace-nowrap inline-block text-center">
      Candidatar-se
    </span>
  </div>
</a>
