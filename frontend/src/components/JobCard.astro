---
interface Props {
  id: string;
  title: string;
  company: string;
  location: string;
  salary?: string;
  logo?: string;
  isNew?: boolean;
}

const { id, title, company, location, salary, logo, isNew = false } = Astro.props;
---

<a href={`/vagas/${id}`} class="block bg-surface-container-lowest p-lg rounded-xl border border-outline-variant hover:shadow-xl transition-all duration-300 group">
  <div class="flex justify-between items-start mb-md">
    <div class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center overflow-hidden border border-outline-variant/30">
      {logo ? (
        <img class="w-10 h-10 object-contain" alt={`Logo ${company}`} src={logo} />
      ) : (
        <span class="font-bold text-on-surface-variant text-xl">{company.charAt(0)}</span>
      )}
    </div>
    {isNew && (
      <span class="bg-primary-container/10 text-primary-fixed-dim text-[10px] font-bold px-sm py-xs rounded-full uppercase tracking-wider">Novo</span>
    )}
  </div>
  <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs group-hover:text-primary transition-colors">{title}</h3>
  <p class="font-body-md text-body-md text-on-surface-variant mb-md">{company}</p>
  <div class="flex flex-wrap items-center gap-md mb-lg">
    <div class="flex items-center gap-xs text-outline">
      <span class="material-symbols-outlined text-[18px]">location_on</span>
      <span class="font-label-sm text-label-sm">{location}</span>
    </div>
    {salary && (
      <div class="flex items-center gap-xs text-outline">
        <span class="material-symbols-outlined text-[18px]">payments</span>
        <span class="font-label-sm text-label-sm">{salary}</span>
      </div>
    )}
  </div>
  <button class="w-full bg-primary-container text-on-primary font-label-md text-label-md py-md rounded-lg hover:brightness-105 active:scale-[0.98] transition-all">
    Candidatar-se
  </button>
</a>
