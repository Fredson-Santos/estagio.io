---
import { formatModality } from '../utils/modality';

interface Props {
  id: string;
  title: string;
  company: string;
  location: string;
  modality?: string;
  salary?: string | null;
  logo?: string | null;
  isNew?: boolean;
  publishedAt?: string;
  searchParams?: string;
  sourceUrl?: string;
  sourceName?: string;
}

const { id, title, company, location, modality, salary, logo, isNew = false, publishedAt, searchParams, sourceUrl, sourceName } = Astro.props;
const displayModality = formatModality(modality);

// Sanitiza visualmente o salário para ignorar objetos stringificados
const isValidSalary = salary && 
  typeof salary === 'string' && 
  !salary.startsWith('{') && 
  !salary.toLowerCase().includes('undisclosed') && 
  !salary.toLowerCase().includes('display') &&
  salary.trim() !== '';

const companyInitials = (company || 'VA').substring(0, 2).toUpperCase();
const jobUrl = `/vagas/${id}${searchParams ? `?${searchParams}` : ''}`;
---

<a href={jobUrl} class="block bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex flex-col transition-all hover:filter-shadow group cursor-pointer h-full relative" style="transform: translateY(0px);">
  <div class="flex justify-between items-start mb-md">
    <div class="w-10 h-10 rounded-full border border-outline-variant overflow-hidden flex-shrink-0 bg-primary/10 flex items-center justify-center relative">
      {logo ? (
        <>
          <img
            class="w-full h-full object-cover"
            alt={`Logo ${company}`}
            src={logo}
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            data-fallback-initials={companyInitials}
          />
        </>
      ) : (
        <div class="w-full h-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">
          {companyInitials}
        </div>
      )}
    </div>
    <div class="flex items-center gap-xs flex-wrap justify-end">
      {isNew && (
        <span class="bg-primary/10 text-primary text-label-sm font-label-sm px-sm py-xs rounded-full font-semibold">
          Novo
        </span>
      )}
      <span class="bg-secondary-container/50 text-on-secondary-container dark:bg-slate-700/80 dark:text-slate-200 dark:border dark:border-slate-600/50 px-sm py-xs rounded-full text-label-sm font-label-sm font-medium">
        {displayModality}
      </span>
    </div>
  </div>
  <h3 class="font-headline-sm text-headline-sm text-on-surface mb-sm group-hover:text-primary transition-colors line-clamp-2 min-h-[56px]">{title}</h3>
  <div class="flex flex-col gap-xs text-on-surface-variant text-body-sm font-body-sm mb-lg">
    <span class="flex items-center gap-xs">
      <span class="material-symbols-outlined text-[16px]">business</span>
      <span class="line-clamp-1">{company}</span>
    </span>
    <span class="flex items-center gap-xs">
      <span class="material-symbols-outlined text-[16px]">location_on</span>
      <span class="line-clamp-1">{location}</span>
    </span>
    {isValidSalary && (
      <span class="flex items-center gap-xs">
        <span class="material-symbols-outlined text-[16px]">payments</span>
        <span>{salary}</span>
      </span>
    )}
  </div>
  <div class="mt-auto pt-md border-t border-outline-variant/30 flex flex-wrap justify-between items-center gap-md">
    <span class="text-label-sm font-label-sm text-outline">{publishedAt || 'Recente'}</span>
    <span class="bg-primary text-on-primary px-lg py-2.5 rounded-lg font-label-md text-label-md group-hover:bg-primary-container transition-all active:scale-95 whitespace-nowrap inline-block text-center">
      Candidatar-se
    </span>
  </div>
    </a>

<script>
  // Fallback de logo: se a imagem falhar, troca pelas iniciais da empresa
  document.querySelectorAll('img[data-fallback-initials]').forEach((img) => {
    img.addEventListener('error', () => {
      const initials = img.getAttribute('data-fallback-initials') || 'VA';
      const parent = img.parentElement;
      if (parent) {
        (img as HTMLElement).style.display = 'none';
        const fallback = document.createElement('div');
        fallback.className = 'w-full h-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm';
        fallback.textContent = initials;
        parent.appendChild(fallback);
      }
    });
  });
</script>
