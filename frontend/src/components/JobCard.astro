---
interface Props {
  id: string;
  title: string;
  company: string;
  location: string;
  salary?: string;
  logo?: string;
  isNew?: boolean;
}

const { id, title, company, location, salary, logo, isNew = false } = Astro.props;
---

<a href={`/vagas/${id}`} class="block bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex flex-col transition-all hover:filter-shadow group cursor-pointer h-full relative" style="transform: translateY(0px);">
  <div class="flex justify-between items-start mb-md">
    <div class="w-12 h-12 rounded-full bg-surface border border-outline-variant flex items-center justify-center overflow-hidden flex-shrink-0">
      {logo ? (
        <img class="w-8 h-8 object-contain" alt={`Logo ${company}`} src={logo} />
      ) : (
        <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold">
          {company.substring(0, 2).toUpperCase()}
        </div>
      )}
    </div>
    <span class="bg-secondary-container/50 text-on-secondary-container px-sm py-xs rounded-full text-label-sm font-label-sm">
      {Astro.props.modality || (isNew ? 'Novo' : 'Presencial')}
    </span>
  </div>
  <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs group-hover:text-primary transition-colors line-clamp-2 min-h-[56px]">{title}</h3>
  <div class="flex flex-wrap items-center gap-sm text-on-surface-variant text-body-sm font-body-sm mb-lg">
    <span class="flex items-center gap-xs"><span class="material-symbols-outlined text-[18px]">business</span>{company}</span>
    <span class="text-outline-variant">•</span>
    <span class="flex items-center gap-xs"><span class="material-symbols-outlined text-[18px]">location_on</span>{location}</span>
    {salary && (
      <>
        <span class="text-outline-variant">•</span>
        <span class="flex items-center gap-xs"><span class="material-symbols-outlined text-[18px]">payments</span>{salary}</span>
      </>
    )}
  </div>
  <div class="mt-auto pt-md border-t border-outline-variant/30 flex flex-wrap justify-between items-center gap-md">
    <span class="text-label-sm font-label-sm text-outline">{Astro.props.publishedAt || 'Recente'}</span>
    <button class="bg-primary text-on-primary px-lg py-2.5 rounded-lg font-label-md text-label-md hover:bg-primary-container transition-all active:scale-95 whitespace-nowrap">
      Candidatar-se
    </button>
  </div>
</a>
