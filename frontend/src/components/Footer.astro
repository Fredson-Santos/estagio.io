---
const year = new Date().getFullYear();
---

<footer class="w-full py-xl bg-surface border-t border-outline-variant/30 px-gutter">
  <div class="max-w-container-max mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-xl">
      <div>
        <a href="/" class="font-headline-sm text-headline-sm font-bold text-on-surface tracking-tight">estagio<span class="text-primary">.io</span></a>
        <p class="font-body-sm text-body-sm text-on-surface-variant mt-sm">© {year} estagio.io. Todos os direitos reservados. Conectando talentos a oportunidades.</p>
      </div>
      <div class="flex flex-wrap gap-lg">
        <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors" href="/vagas">Vagas</a>
        <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors" href="/sobre">Sobre nós</a>
        <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors" href="/sobre#missao">Nossa Missão</a>
