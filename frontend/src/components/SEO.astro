---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: string;
  image?: string;
}

const SITE_URL = 'https://estagio.io';
const DEFAULT_OG_IMAGE = `${SITE_URL}/og-image.jpg`;

const { 
  title, 
  description, 
  canonical = Astro.url.href,
  type = "website",
  image = DEFAULT_OG_IMAGE,
} = Astro.props;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="estagio.io" />
<meta property="og:locale" content="pt_BR" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<!-- Inter self-hosted: preload do peso 400 (body text) — sem round-trip para Google -->
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/inter-latin-400-normal.woff2"
  crossorigin
/>

<!-- Material Symbols: preconnect para resolver DNS/TLS antecipadamente -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<!-- Material Symbols: URL otimizada com eixos fixos e display=swap (evita payload de 3.8MB) -->
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
  onload="this.onload=null;this.rel='stylesheet'"
/>
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap">
</noscript>

