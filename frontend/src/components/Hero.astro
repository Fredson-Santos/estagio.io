---
---

<section class="hero">
  <div class="container">
    <h1>encontre seu estágio</h1>
    <p class="subtitle">
      As melhores vagas de estágio reunidas em um só lugar.
    </p>
    
    <div class="tags">
      <span class="tag">Gupy</span>
      <span class="tag">CIEE</span>
      <span class="tag">Vagas.com</span>
      <span class="tag">InfoJobs</span>
      <span class="tag">Catho</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 56px;
    margin-bottom: 40px;
    text-align: center;
  }
  
  h1 {
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-bottom: 16px;
    line-height: 1.1;
    color: var(--c-foreground);
  }
  
  @media (min-width: 640px) {
    h1 {
      font-size: 48px;
      line-height: 1;
    }
  }

  .subtitle {
    font-size: 16px;
    line-height: 1.625;
    color: var(--c-muted-foreground);
    max-width: 36rem;
    margin: 0 auto 20px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }

  .tag {
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    color: var(--c-muted-foreground);
    background-color: var(--c-secondary);
    border: 1px solid var(--c-border);
    padding: 4px 10px;
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 32px;
      margin-bottom: 24px;
    }

    .subtitle {
      font-size: 14px;
      margin-bottom: 16px;
    }

    .tags {
      gap: 6px;
    }

    .tag {
      font-size: 11px;
      padding: 3px 8px;
    }
  }
</style>
