---
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/index.html';
const isVagas = pathname.startsWith('/vagas');
const isSobre = pathname.startsWith('/sobre');
---

<nav class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30">
<div class="flex justify-between items-center h-16 px-gutter max-w-container-max mx-auto">
<div class="flex items-center gap-sm">
<a href="/" class="font-headline-sm text-headline-sm font-bold text-on-surface tracking-tight">estagio.io</a>
</div>
<div class="hidden md:flex items-center gap-lg">
<a class={`font-label-md text-label-md transition-colors duration-200 ${isHome ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant hover:text-primary'}`} href="/">Início</a>
<a class={`font-label-md text-label-md transition-colors duration-200 ${isVagas ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant hover:text-primary'}`} href="/vagas">Vagas</a>
<a class={`font-label-md text-label-md transition-colors duration-200 ${isSobre ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant hover:text-primary'}`} href="/sobre">Sobre</a>
</div>
<div class="flex items-center gap-md">
<button class="hidden md:block font-label-md text-label-md text-on-surface-variant hover:text-primary active:scale-95 transition-all">Entrar</button>
<button class="bg-primary-container text-on-primary font-label-md text-label-md px-lg py-sm rounded-lg active:scale-95 transition-all shadow-sm">Cadastrar-se</button>
</div>
</div>
</nav>
