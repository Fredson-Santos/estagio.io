DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/estagio
CORS_ORIGINS=["http://localhost:4321","http://127.0.0.1:4321"]

# LLM provider (escolha um)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Preencha a chave do provider escolhido (deixe as demais vazias)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Intervalo do ETL em horas (0 = desabilitado)
ETL_INTERVAL_HOURS=6
