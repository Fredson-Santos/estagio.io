# Estagio.io - variaveis de ambiente para Dokploy
# Copie para `.env` na raiz e preencha os valores.

# Senha do PostgreSQL (obrigatorio). Use uma senha forte em producao.
POSTGRES_PASSWORD=changeme_strong_password

# Origens permitidas para CORS (JSON array). Inclua a URL publica do frontend.
CORS_ORIGINS=["https://seudominio.com"]

# Chave de acesso à API admin (header X-Admin-Key). Use uma chave forte em produção.
ADMIN_API_KEY=changeme_strong_key

# Senha do painel admin do frontend (/admin/login)
ADMIN_PASSWORD=changeme_admin_password

# Chave secreta para assinatura HMAC do cookie de sessão (use >32 chars aleatórios)
ADMIN_SECRET=generate_a_long_random_secret_here_minimum_32_chars

# --- Scraper (ETL e LLM) ---

# LLM provider: groq | openai | gemini | openrouter
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Preencha a chave do provider escolhido (deixe as demais vazias)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Intervalo do ETL automatico em horas (0 = desabilitado)
ETL_INTERVAL_HOURS=6