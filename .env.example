# ==========================================
# estagio.io — Exemplo de Configuração (.env.example)
# Copie este arquivo para `.env` na raiz e preencha os valores.
# ==========================================

# --- 1. PostgreSQL (Banco de Dados Principal) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=estagio
# DATABASE_URL para conexão direta (ex: local ou container)
DATABASE_URL=postgresql+asyncpg://postgres:changeme_postgres_password@localhost:5432/estagio

# --- 2. Portas & Rede ---
BACKEND_PORT=8001
FRONTEND_PORT=4321
HOST=0.0.0.0
PORT=4321
# Origens permitidas para CORS (JSON array). Inclua a URL pública do frontend.
CORS_ORIGINS=["http://localhost:4321","https://seudominio.com"]

# --- 3. Autenticação & Segurança ---
# Chave de acesso à API admin do Backend (Header X-Admin-Key). Use uma chave forte em produção.
ADMIN_API_KEY=changeme_strong_admin_api_key

# Senha do painel admin do frontend (/admin/login)
ADMIN_PASSWORD=changeme_admin_password

# Chave secreta para assinatura HMAC do cookie de sessão (mínimo 32 caracteres aleatórios)
ADMIN_SECRET=generate_a_long_random_secret_here_minimum_32_chars

# --- 4. Scraper & Integração de Serviços ---
# URL da API Backend para onde o scraper envia os dados ingeridos
BACKEND_URL=http://localhost:8000
# Deve ser igual a ADMIN_API_KEY para autenticar o scraper no Backend
BACKEND_API_KEY=changeme_strong_admin_api_key

# URL do serviço Scraper para trigger via Backend (/api/v1/admin/scrapers/run)
SCRAPER_URL=http://localhost:9090
SCRAPER_DB_PATH=./scraper.db
# Intervalo do ETL automático em horas (0 = desabilitado)
ETL_INTERVAL_HOURS=6
# Modo de classificação de áreas: regex (default) | llm (via Groq/OpenAI)
AREA_MATCHER_MODE=regex

# --- 5. LLM Providers (Groq / Gemini / OpenAI / OpenRouter) ---
# Provider ativo: groq | openai | gemini | openrouter
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Preencha a chave do provider escolhido (deixe as demais vazias)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=