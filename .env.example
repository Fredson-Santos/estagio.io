# Estagio.io - variáveis de ambiente para Dokploy
# Copie para `.env` na raiz e preencha os valores.

# Senha do PostgreSQL (obrigatório). Use uma senha forte em produção.
POSTGRES_PASSWORD=

# Origens permitidas para CORS (JSON array). Inclua a URL pública do frontend.
CORS_ORIGINS=["https://seudominio.com"]

# LLM provider: groq | openai | gemini | openrouter
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Preencha a chave do provider escolhido (deixe as demais vazias)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Intervalo do ETL automático em horas (0 = desabilitado)
ETL_INTERVAL_HOURS=6
